# PostgreSQL connection string (any Postgres 14+: local, Neon, Supabase, RDS…)
DATABASE_URL=postgres://folio:folio@127.0.0.1:5432/folio_dev

# Optional — enables the AI assistant. Without it, Folio uses its built-in
# offline parser for natural-language entries (every change still needs confirmation).
OPENAI_API_KEY=
# Optional — override the model used for parsing (default: gpt-5.4-mini)
OPENAI_MODEL=

# Development only — shows the demo account on the sign-in page.
# Never enable this in production.
FOLIO_DEMO_LOGIN=0
